    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst meetingTitle = items[0].json.output.meeting_title;\nconst summary = items[0].json.output.summary;\n\nconst taskText = items.map((item, index) => {\n  const task = item.json[\"output.action_items\"];\n\n  return `${index + 1}. ${task.person} — ${task.task} — Deadline: ${task.deadline}`;\n}).join('\\n');\n\nreturn [\n  {\n    json: {\n      meetingTitle: meetingTitle,\n      summary: summary,\n      taskText: taskText\n    }\n  }\n];"
      },
